<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>PREFERENSI AKUN</div><h1>Pengaturan <em>ruangmu.</em></h1><p class="heading-copy">Atur dompet, kategori, integrasi, dan pengingat.</p></div></section>
<div class="settings-grid">
  <section class="surface-section settings-section"><div class="section-heading"><div><span class="section-kicker">IDENTITAS</span><h2>Profil</h2></div></div><div class="profile-avatar-preview"><span class="avatar avatar-large" style="background:<%= currentUser.avatar_color || '#ffd7c2' %>"><%= currentUser.name.charAt(0) %></span><div><strong>Foto profil default</strong><small>Avatar unik untuk akunmu, tidak dibagikan dengan user lain.</small></div></div><form class="stack-form" action="/settings/profile" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="profile-name">Nama lengkap</label><input id="profile-name" name="name" value="<%= currentUser.name %>" maxlength="80" required><label for="account-email">Email login</label><input id="account-email" value="<%= currentUser.email %>" readonly><label for="contact-email">Alamat email kontak</label><input id="contact-email" name="contact_email" type="email" value="<%= currentUser.contact_email || '' %>" placeholder="Isi sendiri bila berbeda"><label for="job-title">Pekerjaan / jabatan</label><input id="job-title" name="job_title" value="<%= currentUser.job_title || '' %>" maxlength="80" placeholder="Belum diisi"><label for="bio">Bio singkat</label><textarea id="bio" name="bio" rows="3" maxlength="280" placeholder="Ceritakan sedikit tentang dirimu"><%= currentUser.bio || '' %></textarea><button class="button button-dark" type="submit">Simpan profil</button></form></section>
  <section class="surface-section settings-section"><div class="section-heading"><div><span class="section-kicker">SALDO TERPISAH</span><h2>Dompet</h2></div></div><div class="settings-list"><% wallets.forEach((wallet) => { %><div class="settings-list-row"><span class="wallet-color" style="--wallet-color:<%= wallet.color %>"></span><strong><%= wallet.name %></strong><span><%= wallet.wallet_type === 'bank' ? 'Bank' : wallet.wallet_type === 'ewallet' ? 'E-Wallet' : 'Tunai' %><%= wallet.institution ? ` · ${wallet.institution}` : '' %> · <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(wallet.balance) %></span><% if (wallet.is_default) { %><small>Default</small><% } %></div><% }) %></div><form class="inline-create-form wallet-create-form" action="/settings/wallets" method="post" data-wallet-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Jenis dompet<select name="wallet_type" data-wallet-type><option value="cash">Tunai</option><option value="bank">Rekening bank</option><option value="ewallet">E-Wallet</option></select></label><label>Nama dompet<input name="name" required maxlength="40" placeholder="Contoh: BCA Harian"></label><label data-institution-field="bank" hidden>Bank<select name="institution" disabled><option value="">Pilih bank</option><option>BRI</option><option>BCA</option><option>Mandiri</option><option>BNI</option><option>BSI</option><option>CIMB Niaga</option><option>Danamon</option><option>Permata</option></select></label><label data-institution-field="ewallet" hidden>E-Wallet<select name="institution" disabled><option value="">Pilih e-wallet</option><option>DANA</option><option>GoPay</option><option>OVO</option><option>ShopeePay</option><option>LinkAja</option></select></label><label>Saldo awal (Rp)<input name="openingBalance" type="number" min="0" step="1" value="0" required></label><label class="check-label"><input name="isDefault" type="checkbox" value="true"> Jadikan default</label><button class="button button-outline" type="submit">+ Tambah dompet</button></form></section>
  <section class="surface-section settings-section"><div class="section-heading"><div><span class="section-kicker">PENGELOMPOKAN</span><h2>Kategori</h2></div></div><div class="category-chips"><% categories.forEach((category) => { %><span class="category-chip"><%= category.emoji %> <%= category.name %><small><%= category.type === 'income' ? 'Masuk' : 'Keluar' %></small></span><% }) %></div><form class="inline-create-form" action="/settings/categories" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Nama kategori<input name="name" maxlength="40" required></label><label>Jenis<select name="type"><option value="expense">Pengeluaran</option><option value="income">Pemasukan</option></select></label><label>Emoji<input name="emoji" maxlength="8" value="📌"></label><button class="button button-outline" type="submit">+ Tambah kategori</button></form></section>
  <section class="surface-section settings-section" id="budget"><div class="section-heading"><div><span class="section-kicker">BATAS PENGELUARAN</span><h2>Budget bulanan</h2></div></div><form class="inline-create-form" action="/settings/budgets" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Kategori<select name="categoryId" required><% categories.filter((category) => category.type === 'expense').forEach((category) => { %><option value="<%= category.id %>"><%= category.emoji %> <%= category.name %></option><% }) %></select></label><label>Bulan<input name="month" type="month" value="<%= currentMonth %>" required></label><label>Batas (Rp)<input name="limitAmount" type="number" min="1" step="1" required></label><label>Alert (%)<input name="alertThreshold" type="number" min="1" max="100" value="80" required></label><button class="button button-outline" type="submit">Simpan budget</button></form></section>
  <section class="surface-section settings-section"><div class="section-heading"><div><span class="section-kicker">TELEGRAM</span><h2>Hubungkan bot</h2></div><span class="integration-status <%= telegram && telegram.enabled ? 'is-connected' : '' %>"><%= telegram && telegram.enabled ? 'Bot aktif' : 'Belum terhubung' %></span></div><p class="section-copy">Token disimpan terenkripsi. Polling cocok untuk localhost; webhook memerlukan URL HTTPS publik.</p><form class="stack-form" action="/settings/telegram/test" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="telegram-token">Token dari BotFather</label><input id="telegram-token" name="bot_token" type="password" autocomplete="new-password" placeholder="123456:ABC..." required><button class="button button-outline" type="submit">Test koneksi (getMe) & hubungkan</button></form><% if (telegram && telegram.link_code) { %><div class="pairing-code"><small>KIRIM KE BOT DI TELEGRAM</small><code>/start <%= telegram.link_code %></code></div><% } %><% if (telegram && telegram.chat_id) { %><p class="integration-detail">Chat ID terhubung: <strong><%= telegram.chat_id %></strong></p><% } %><% if (telegram && telegram.enabled) { %><div class="transport-actions"><% if (telegram.transport === 'polling') { %><form action="/settings/telegram/webhook" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="webhook"><button class="button button-outline" type="submit" <%= webhookConfigured ? '' : 'disabled' %>>Aktifkan webhook HTTPS</button></form><% } else { %><form action="/settings/telegram/webhook" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="polling"><button class="button button-outline" type="submit">Kembali ke polling</button></form><% } %></div><% } %></section>
  <section class="surface-section settings-section"><div class="section-heading"><div><span class="section-kicker">PENGINGAT HARIAN</span><h2>Pengingat</h2></div></div><p class="section-copy">Zona waktu akun: <strong>Asia/Jakarta (WIB)</strong>.</p><form class="inline-create-form" action="/settings/reminder" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Waktu pengingat<input name="reminder_time" type="time" value="<%= preferences && preferences.reminder_time || '' %>"></label><button class="button button-outline" type="submit">Simpan pengingat</button></form></section>
</div>
<%- include('../partials/app-foot') %>