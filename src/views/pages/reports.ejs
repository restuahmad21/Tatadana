<%- include('../partials/app-head', { title, active }) %>
<%
  const reportData = report && typeof report === 'object' ? report : {};
  const reportRows = Array.isArray(reportData.rows) ? reportData.rows.filter(Boolean) : [];
  const reportWallets = Array.isArray(wallets) ? wallets.filter(Boolean) : [];
  const reportCategories = Array.isArray(categories) ? categories.filter(Boolean) : [];
  const reportFilters = filters && typeof filters === 'object' ? filters : {};
  const reportTotals = reportData.totals && typeof reportData.totals === 'object' ? reportData.totals : {};
  const reportIncome = Number.isFinite(Number(reportTotals.income)) ? Number(reportTotals.income) : 0;
  const reportExpense = Number.isFinite(Number(reportTotals.expense)) ? Number(reportTotals.expense) : 0;
  const reportCount = Number.isFinite(Number(reportData.count)) ? Number(reportData.count) : reportRows.length;
  const reportPage = Math.max(1, Number(reportData.page) || 1);
  const reportPages = Math.max(1, Number(reportData.pages) || 1);
  const safeQueryString = typeof queryString === 'string' ? queryString : '';
  const formatReportDate = (value) => {
    if (typeof value !== 'string' || !value) return '—';
    const date = new Date(`${value.replace(' ', 'T')}+07:00`);
    return Number.isFinite(date.getTime()) ? new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).format(date) : '—';
  };
  const reportNumber = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
%>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>RIWAYAT KEUANGAN</div><h1>Laporan <em>transaksi.</em></h1><p class="heading-copy">Cari, saring, dan unduh catatan keuanganmu.</p></div><a class="button button-outline" href="/reports/export.csv?<%= safeQueryString %>">Unduh CSV <span>↓</span></a></section>
<section class="report-summary"><article><span>PEMASUKAN</span><strong class="positive"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(reportIncome) %></strong></article><article><span>PENGELUARAN</span><strong class="negative"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(reportExpense) %></strong></article><article><span>SELISIH</span><strong><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(reportIncome - reportExpense) %></strong></article></section>
<section class="surface-section report-section">
  <form class="filter-form" method="get" action="/reports">
    <label class="search-field"><span>Cari catatan</span><input type="search" name="q" value="<%= reportFilters.search || '' %>" placeholder="Ketik kata kunci"></label>
    <label><span>Jenis</span><select name="type"><option value="">Semua jenis</option><option value="income" <%= reportFilters.type === 'income' ? 'selected' : '' %>>Pemasukan</option><option value="expense" <%= reportFilters.type === 'expense' ? 'selected' : '' %>>Pengeluaran</option><option value="transfer" <%= reportFilters.type === 'transfer' ? 'selected' : '' %>>Transfer</option></select></label>
    <label><span>Dompet</span><select name="wallet"><option value="">Semua dompet</option><% reportWallets.forEach((wallet) => { %><option value="<%= wallet.id %>" <%= String(reportFilters.walletId || '') === String(wallet.id) ? 'selected' : '' %>><%= wallet.name || 'Dompet' %></option><% }) %></select></label>
    <label><span>Kategori</span><select name="category"><option value="">Semua kategori</option><% reportCategories.forEach((category) => { %><option value="<%= category.id %>" <%= String(reportFilters.categoryId || '') === String(category.id) ? 'selected' : '' %>><%= category.emoji || '' %> <%= category.name || 'Kategori' %></option><% }) %></select></label>
    <label><span>Dari</span><input type="date" name="from" value="<%= reportFilters.from || '' %>"></label><label><span>Sampai</span><input type="date" name="to" value="<%= reportFilters.to || '' %>"></label>
    <button class="button button-dark filter-submit" type="submit">Terapkan</button>
  </form>
  <% if (reportRows.length) { %>
    <div class="table-wrap report-table-wrap"><table><thead><tr><th>TANGGAL</th><th>TRANSAKSI</th><th>KATEGORI</th><th>DOMPET</th><th>NOMINAL</th></tr></thead><tbody><% reportRows.forEach((item) => { const type = item.type || 'expense'; %><tr><td><%= formatReportDate(item.occurred_at) %></td><td class="report-note"><strong><%= item.note || (type === 'transfer' ? 'Transfer antar dompet' : item.category_name || 'Transaksi') %></strong><small><%= type === 'income' ? 'Pemasukan' : type === 'expense' ? 'Pengeluaran' : 'Transfer' %></small></td><td><%= item.category_emoji || '↔' %> <%= item.category_name || 'Transfer' %></td><td><%= type === 'transfer' ? [item.wallet_name, item.destination_wallet_name].filter(Boolean).join(' → ') : item.wallet_name || 'Tanpa dompet' %></td><td class="transaction-amount <%= type === 'income' ? 'positive' : type === 'expense' ? 'negative' : '' %>"><%= type === 'income' ? '+' : type === 'expense' ? '−' : '' %><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(reportNumber(item.amount)) %></td></tr><% }) %></tbody></table></div>
    <div class="pagination"><span><%= reportCount %> transaksi · Halaman <%= reportPage %> dari <%= reportPages %></span><div><% if (reportPage > 1) { %><a href="/reports?<%= safeQueryString %>&page=<%= reportPage - 1 %>">← Sebelumnya</a><% } %><% if (reportPage < reportPages) { %><a href="/reports?<%= safeQueryString %>&page=<%= reportPage + 1 %>">Berikutnya →</a><% } %></div></div>
  <% } else { %><div class="report-empty"><span>◎</span><h2>Belum ada transaksi</h2><p>Transaksi yang sesuai filter akan muncul di sini.</p><a href="/dashboard#catat-transaksi">Catat transaksi pertama ↗</a></div><% } %>
</section>
<%- include('../partials/app-foot') %>