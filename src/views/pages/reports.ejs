<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>RIWAYAT KEUANGAN</div><h1>Laporan <em>transaksi.</em></h1><p class="heading-copy">Cari, saring, dan unduh catatan keuanganmu.</p></div><a class="button button-outline" href="/reports/export.csv?<%= queryString %>">Unduh CSV <span>↓</span></a></section>
<section class="report-summary"><article><span>PEMASUKAN</span><strong class="positive"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(report.totals.income) %></strong></article><article><span>PENGELUARAN</span><strong class="negative"><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(report.totals.expense) %></strong></article><article><span>SELISIH</span><strong><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(report.totals.income - report.totals.expense) %></strong></article></section>
<section class="surface-section report-section">
  <form class="filter-form" method="get" action="/reports">
    <label class="search-field"><span>Cari catatan</span><input type="search" name="q" value="<%= filters.search %>" placeholder="Ketik kata kunci"></label>
    <label><span>Jenis</span><select name="type"><option value="">Semua jenis</option><option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>Pemasukan</option><option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>Pengeluaran</option><option value="transfer" <%= filters.type === 'transfer' ? 'selected' : '' %>>Transfer</option></select></label>
    <label><span>Dompet</span><select name="wallet"><option value="">Semua dompet</option><% wallets.forEach((wallet) => { %><option value="<%= wallet.id %>" <%= String(filters.walletId) === String(wallet.id) ? 'selected' : '' %>><%= wallet.name %></option><% }) %></select></label>
    <label><span>Kategori</span><select name="category"><option value="">Semua kategori</option><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= String(filters.categoryId) === String(category.id) ? 'selected' : '' %>><%= category.emoji %> <%= category.name %></option><% }) %></select></label>
    <label><span>Dari</span><input type="date" name="from" value="<%= filters.from %>"></label><label><span>Sampai</span><input type="date" name="to" value="<%= filters.to %>"></label>
    <button class="button button-dark filter-submit" type="submit">Terapkan</button>
  </form>
  <% if (report.rows.length) { %>
    <div class="table-wrap report-table-wrap"><table><thead><tr><th>TANGGAL</th><th>TRANSAKSI</th><th>KATEGORI</th><th>DOMPET</th><th>NOMINAL</th></tr></thead><tbody><% report.rows.forEach((item) => { %><tr><td><%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).format(new Date(item.occurred_at.replace(' ', 'T') + '+07:00')) %></td><td class="report-note"><strong><%= item.note || (item.type === 'transfer' ? 'Transfer antar dompet' : item.category_name) %></strong><small><%= item.type === 'income' ? 'Pemasukan' : item.type === 'expense' ? 'Pengeluaran' : 'Transfer' %></small></td><td><%= item.category_emoji || '↔' %> <%= item.category_name || 'Transfer' %></td><td><%= item.type === 'transfer' ? `${item.wallet_name} → ${item.destination_wallet_name}` : item.wallet_name %></td><td class="transaction-amount <%= item.type === 'income' ? 'positive' : item.type === 'expense' ? 'negative' : '' %>"><%= item.type === 'income' ? '+' : item.type === 'expense' ? '−' : '' %><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(item.amount) %></td></tr><% }) %></tbody></table></div>
    <div class="pagination"><span><%= report.count %> transaksi · Halaman <%= report.page %> dari <%= report.pages %></span><div><% if (report.page > 1) { %><a href="/reports?<%= queryString %>&page=<%= report.page - 1 %>">← Sebelumnya</a><% } %><% if (report.page < report.pages) { %><a href="/reports?<%= queryString %>&page=<%= report.page + 1 %>">Berikutnya →</a><% } %></div></div>
  <% } else { %><div class="report-empty"><span>◎</span><h2>Belum ada transaksi</h2><p>Transaksi yang sesuai filter akan muncul di sini.</p><a href="/dashboard#catat-transaksi">Catat transaksi pertama ↗</a></div><% } %>
</section>
<%- include('../partials/app-foot') %>