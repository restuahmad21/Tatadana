<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading admin-heading">
  <div><div class="eyebrow"><span class="eyebrow-line"></span>AKSES TERBATAS · SUPER ADMIN</div><h1>Panel<br><em>administrasi.</em></h1></div>
  <div class="admin-count"><strong><%= users.length.toString().padStart(2, '0') %></strong><span>AKUN TERDAFTAR</span></div>
</section>
<section class="admin-table-section">
  <div class="table-heading"><div><span class="section-kicker">DIREKTORI PENGGUNA</span><h2>Akun TataDana</h2></div><span class="table-total"><%= users.length %> akun</span></div>
  <% if (users.length) { %>
    <div class="table-wrap"><table><thead><tr><th>NAMA</th><th>EMAIL</th><th>PROFIL</th><th>STATUS</th><th>ROLE</th><th>BERGABUNG</th><th>AKSI</th></tr></thead><tbody>
      <% users.forEach((user) => { %><tr><td class="table-name"><span class="table-avatar" style="background:<%= user.avatar_color || '#ffd7c2' %>"><%= user.name.charAt(0) %></span><%= user.name %></td><td><%= user.email %></td><td><%= [user.job_title, user.contact_email].filter(Boolean).join(' · ') || 'Belum dilengkapi' %></td><td><span class="role-tag <%= user.approval_status === 'approved' ? 'status-approved' : user.approval_status === 'rejected' ? 'status-rejected' : 'status-pending' %>"><%= user.approval_status === 'approved' ? 'Disetujui' : user.approval_status === 'rejected' ? 'Ditolak' : 'Menunggu' %></span></td><td><span class="role-tag <%= user.role === 'admin' ? 'role-admin' : '' %>"><%= user.role === 'admin' ? 'Admin' : 'Pengguna' %></span></td><td><%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(new Date(`${user.created_at.replace(' ', 'T')}Z`)) %></td><td><div class="review-actions"><a class="button-small approve-button" href="/admin/users/<%= user.id %>">Detail</a><% if (user.approval_status === 'pending') { %><form action="/admin/users/<%= user.id %>/approval" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-small approve-button" type="submit" name="decision" value="approve">Setujui</button></form><form action="/admin/users/<%= user.id %>/approval" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-small reject-button" type="submit" name="decision" value="reject">Tolak</button></form><% } %><% if (user.id !== currentUser.id) { %><form class="role-form" action="/admin/users/<%= user.id %>/role" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="role" aria-label="Role untuk <%= user.name %>"><option value="user" <%= user.role === 'user' ? 'selected' : '' %>>Pengguna</option><option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option></select><button class="button-small approve-button" type="submit">Simpan role</button></form><% } %></div></td></tr><% }) %>
    </tbody></table></div>
  <% } else { %>
    <div class="admin-empty">Belum ada akun terdaftar.</div>
  <% } %>
</section>
<section class="admin-table-section admin-operations">
  <div class="table-heading"><div><span class="section-kicker">PENERIMAAN</span><h2>Review pembayaran</h2></div><span class="table-total"><%= payments.filter((payment) => payment.status === 'pending').length %> menunggu</span></div>
  <% if (payments.length) { %>
    <div class="table-wrap"><table><thead><tr><th>PENGGUNA</th><th>PAKET</th><th>METODE</th><th>NOMINAL</th><th>STATUS</th><th>AKSI</th></tr></thead><tbody><% payments.forEach((payment) => { %><tr><td class="payment-user"><strong><%= payment.name %></strong><small><%= payment.email %></small></td><td><%= payment.plan === 'starter' ? 'Starter' : 'Pro' %></td><td><%= payment.provider === 'midtrans' ? 'Midtrans' : 'Manual' %></td><td><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(payment.amount) %></td><td><span class="role-tag <%= payment.status === 'approved' ? 'status-approved' : payment.status === 'rejected' ? 'status-rejected' : 'status-pending' %>"><%= payment.status === 'approved' ? 'Disetujui' : payment.status === 'rejected' ? 'Ditolak' : 'Menunggu' %></span></td><td><% if (payment.status === 'pending' && payment.provider === 'manual') { %><div class="review-actions"><form action="/admin/payments/<%= payment.id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-small approve-button" type="submit">Setujui</button></form><form action="/admin/payments/<%= payment.id %>/reject" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-small reject-button" type="submit">Tolak</button></form></div><% } else { %><span class="table-muted">—</span><% } %></td></tr><% }) %></tbody></table></div>
  <% } else { %><div class="admin-empty">Belum ada permintaan pembayaran.</div><% } %>
</section>
<section class="admin-tool-grid">
  <section class="surface-section admin-tool"><div class="section-heading"><div><span class="section-kicker">AI PROVIDER</span><h2>Gemini</h2></div><span class="integration-status <%= aiKeyConfigured ? 'is-connected' : '' %>"><%= aiKeyConfigured ? 'Siap digunakan' : 'Belum diatur' %></span></div><p class="section-copy">API key terenkripsi saat disimpan. Tombol menyimpan hanya setelah tes koneksi berhasil.</p><form class="stack-form" action="/admin/integrations/gemini" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="gemini-key">Gemini API key</label><input id="gemini-key" name="api_key" type="password" autocomplete="new-password" placeholder="Tempel API key untuk tes dan simpan" required><button class="button button-outline" type="submit">Test koneksi & simpan</button></form><% if (aiKeyConfigured) { %><form class="remove-key-form" action="/admin/integrations/gemini/remove" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button-small reject-button" type="submit">Hapus key tersimpan</button></form><% } %></section>
  <section class="surface-section admin-tool"><div class="section-heading"><div><span class="section-kicker">KEAMANAN RAHASIA</span><h2>Penyimpanan key</h2></div></div><p class="section-copy">Key provider tidak pernah ditampilkan ulang. Enkripsi lokal AES-256-GCM memakai kunci terpisah di folder <code>data</code>; atur <code>APP_ENCRYPTION_KEY</code> untuk deployment.</p><div class="admin-key-status"><span class="status-dot <%= aiKeyConfigured ? 'status-dot-on' : '' %>"></span><span><%= aiKeyConfigured ? 'Provider Gemini tersedia' : 'AI fallback lokal aktif' %></span></div></section>
</section>
<section class="admin-table-section">
  <div class="table-heading"><div><span class="section-kicker">AKTIVITAS SISTEM</span><h2>Log terbaru</h2></div><span class="table-total"><%= logs.length %> entri</span></div>
  <% if (logs.length) { %><div class="table-wrap"><table><thead><tr><th>WAKTU</th><th>LEVEL</th><th>EVENT</th><th>DETAIL</th><th>AKUN</th></tr></thead><tbody><% logs.forEach((log) => { %><tr><td><%= log.created_at %></td><td><span class="role-tag <%= log.level === 'error' ? 'status-rejected' : log.level === 'warning' ? 'status-pending' : '' %>"><%= log.level %></span></td><td><%= log.event %></td><td><%= log.detail %></td><td><%= log.email || 'Sistem' %></td></tr><% }) %></tbody></table></div><% } else { %><div class="admin-empty">Belum ada aktivitas.</div><% } %>
</section>
<%- include('../partials/app-foot') %>