<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>CATATAN KEUANGAN</div><h1>Transaksi <em>terhubung.</em></h1><p class="heading-copy">Catat manual atau mulai percakapan dengan Tata AI.</p></div><a class="button button-outline" href="/reports">Buka laporan <span>↗</span></a></section>
<section class="transaction-workspace">
  <div class="surface-section tata-chat">
    <header class="chat-header"><span class="chat-avatar">t</span><div><strong>Tata AI</strong><small><span class="status-dot status-dot-on"></span> Siap membantu · data tersimpan di akunmu</small></div><span class="chat-mode">TEKS + AI</span></header>
    <div class="chat-messages" aria-live="polite">
      <% if (!messages.length) { %><div class="chat-bubble assistant-bubble"><strong>Halo, <%= currentUser.name.split(' ')[0] %>.</strong><br>Ceritakan transaksi, misalnya “beli makan 5000” atau “nasgor 15000”. Saya akan memastikan wallet yang digunakan sebelum menyimpan.</div><% } %>
      <% messages.forEach((message) => { %><div class="chat-bubble <%= message.role === 'user' ? 'user-bubble' : 'assistant-bubble' %>"><%= message.text %></div><% }) %>
      <% if (draft) { %><div class="draft-status"><span></span>Draft menunggu pilihan wallet · kedaluwarsa <%= new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).format(new Date(`${draft.expires_at.replace(' ', 'T')}Z`)) %> WIB</div><% } %>
    </div>
    <form class="chat-compose" action="/transactions/assistant" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="sr-only" for="tata-message">Pesan untuk Tata AI</label><input id="tata-message" name="message" type="text" maxlength="240" placeholder="Contoh: beli makan 5000" autocomplete="off" required><button class="button button-dark" type="submit" aria-label="Kirim ke Tata AI">Kirim <span>↗</span></button></form>
  </div>
  <aside class="surface-section transaction-history"><div class="section-heading"><div><span class="section-kicker">TERHUBUNG KE DATABASE</span><h2>Transaksi terbaru</h2></div><span class="table-total"><%= transactions.length %></span></div><% if (transactions.length) { %><div class="transaction-list"><% transactions.forEach((item) => { %><article class="transaction-row"><span class="transaction-icon <%= item.type %>"><%= item.type === 'income' ? '↓' : item.type === 'transfer' ? '⇄' : '↑' %></span><span class="transaction-description"><strong><%= item.note || item.category_name || 'Transfer' %></strong><small><%= item.category_name || 'Transfer' %> · <%= item.wallet_name %></small></span><span class="transaction-amount <%= item.type === 'income' ? 'positive' : item.type === 'expense' ? 'negative' : '' %>"><%= item.type === 'income' ? '+' : item.type === 'expense' ? '−' : '' %><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(item.amount) %></span></article><% }) %></div><% } else { %><div class="report-empty"><span>＋</span><h2>Belum ada catatan</h2><p>Transaksi yang tersimpan akan muncul di sini.</p></div><% } %></aside>
</section>
<%- include('../partials/app-foot') %>