<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>AKTIVITAS KEUANGAN · WIB</div><h1>Kalender <em>catatan.</em></h1><p class="heading-copy">Pilih tanggal untuk melihat transaksi atau menulis catatan.</p></div></section>
<section class="calendar-layout">
  <div class="surface-section calendar-panel">
    <div class="calendar-toolbar"><a class="calendar-step" href="/calendar?month=<%= previous %>">←</a><h2><%= monthLabel %></h2><a class="calendar-step" href="/calendar?month=<%= next %>">→</a><a class="calendar-today" href="/calendar">Hari ini</a></div>
    <div class="calendar-grid" role="grid" aria-label="Kalender <%= monthLabel %>">
      <% ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'].forEach((weekday) => { %><div class="calendar-weekday" role="columnheader"><%= weekday %></div><% }) %>
      <% cells.forEach((cell) => { %><% if (cell) { %><a class="calendar-day <%= cell.date === selectedDate ? 'is-selected' : '' %> <%= cell.date === new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date()) ? 'is-today' : '' %>" role="gridcell" href="/calendar?month=<%= month %>&date=<%= cell.date %>" aria-label="<%= cell.date %>, <%= cell.event ? cell.event.count + ' transaksi' : 'tanpa transaksi' %>, <%= cell.noteCount %> catatan"><span class="calendar-day-number"><%= cell.day %></span><% if (cell.event) { %><span class="calendar-event-total"><%= new Intl.NumberFormat('id-ID', { notation: 'compact', maximumFractionDigits: 0 }).format(cell.event.income + cell.event.expense) %></span><% } %><span class="calendar-markers"><% if (cell.event && cell.event.count) { %><i class="calendar-transaction-marker"></i><% } %><% if (cell.noteCount) { %><i class="calendar-note-marker"></i><% } %></span></a><% } else { %><div class="calendar-day is-empty" aria-hidden="true"></div><% } %><% }) %>
    </div>
    <div class="calendar-legend"><span><i class="calendar-transaction-marker"></i>Ada transaksi</span><span><i class="calendar-note-marker"></i>Ada catatan</span></div>
  </div>
  <aside class="surface-section calendar-detail">
    <div class="section-heading"><div><span class="section-kicker">TANGGAL TERPILIH</span><h2><%= new Intl.DateTimeFormat('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(new Date(`${selectedDate}T12:00:00+07:00`)) %></h2></div></div>
    <section class="calendar-day-records"><h3>Transaksi hari ini</h3><% if (selectedTransactions.length) { %><div class="transaction-list"><% selectedTransactions.forEach((item) => { %><article class="transaction-row"><span class="transaction-icon <%= item.type %>"><%= item.type === 'income' ? '↓' : item.type === 'transfer' ? '⇄' : '↑' %></span><span class="transaction-description"><strong><%= item.note || item.category_name || 'Transfer' %></strong><small><%= item.category_emoji || '↔' %> <%= item.category_name || 'Transfer' %> · <%= item.wallet_name %></small></span><span class="transaction-amount <%= item.type === 'income' ? 'positive' : item.type === 'expense' ? 'negative' : '' %>"><%= item.type === 'income' ? '+' : item.type === 'expense' ? '−' : '' %><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(item.amount) %></span></article><% }) %></div><% } else { %><p class="empty-inline">Tidak ada transaksi pada tanggal ini.</p><% } %></section>
    <section class="calendar-day-records"><div class="section-heading"><h3>Catatan</h3></div><% if (selectedNotes.length) { %><div class="note-list"><% selectedNotes.forEach((note) => { %><article class="note-entry"><div><strong><%= note.title || 'Catatan harian' %></strong><p><%= note.body %></p></div><form action="/calendar/notes/<%= note.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="note_date" value="<%= selectedDate %>"><button class="button-small reject-button" type="submit" aria-label="Hapus catatan">Hapus</button></form></article><% }) %></div><% } else { %><p class="empty-inline">Belum ada catatan untuk tanggal ini.</p><% } %>
      <form class="stack-form calendar-note-form" action="/calendar/notes" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="note_date" value="<%= selectedDate %>"><label for="note-title">Judul (opsional)</label><input id="note-title" name="title" maxlength="100" placeholder="Contoh: tagihan listrik"><label for="note-body">Catatan</label><textarea id="note-body" name="body" rows="3" maxlength="2000" placeholder="Tulis catatan untuk tanggal ini" required></textarea><button class="button button-dark" type="submit">Simpan catatan <span>↗</span></button></form>
    </section>
  </aside>
</section>
<%- include('../partials/app-foot') %>