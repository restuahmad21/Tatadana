<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>PROFIL PENGGUNA</div><h1><%= user.name %></h1><p class="heading-copy"><%= user.email %> · Terdaftar <%= new Intl.DateTimeFormat('id-ID', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(new Date(`${user.created_at.replace(' ', 'T')}Z`)) %></p></div><a class="button button-outline" href="/admin">← Kembali ke panel</a></section>
<div class="admin-user-grid">
  <section class="surface-section"><div class="section-heading"><div><span class="section-kicker">PROFIL</span><h2>Informasi akun</h2></div><span class="role-tag <%= user.role === 'admin' ? 'role-admin' : '' %>"><%= user.role === 'admin' ? 'Admin' : 'Pengguna' %></span></div><dl class="profile-details"><dt>Nama lengkap</dt><dd><%= user.name %></dd><dt>Email login</dt><dd><%= user.email %></dd><dt>Email kontak</dt><dd><%= user.contact_email || 'Belum diisi' %></dd><dt>Pekerjaan / jabatan</dt><dd><%= user.job_title || 'Belum diisi' %></dd><dt>Bio</dt><dd><%= user.bio || 'Belum diisi' %></dd><dt>Status pendaftaran</dt><dd><%= user.approval_status === 'approved' ? 'Disetujui' : user.approval_status === 'pending' ? 'Menunggu' : 'Ditolak' %></dd><% if (user.rejection_reason) { %><dt>Alasan penolakan</dt><dd><%= user.rejection_reason %></dd><% } %></dl></section>
  <section class="surface-section"><div class="section-heading"><div><span class="section-kicker">PERSETUJUAN</span><h2>Keputusan admin</h2></div></div><% if (user.approval_status === 'pending' && user.role !== 'admin') { %><form class="approval-actions" action="/admin/users/<%= user.id %>/approval" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Alasan penolakan (opsional)<textarea name="reason" rows="3" maxlength="240" placeholder="Hanya digunakan bila pendaftaran ditolak"></textarea></label><div><button class="button button-dark" type="submit" name="decision" value="approve">Setujui akun</button><button class="button button-outline" type="submit" name="decision" value="reject">Tolak pendaftaran</button></div></form><% } else { %><p class="empty-inline">Pendaftaran ini sudah diproses.</p><% } %></section>
  <section class="surface-section"><div class="section-heading"><div><span class="section-kicker">KONDISI AWAL</span><h2>Dompet terdaftar</h2></div></div><% if (wallets.length) { %><div class="settings-list"><% wallets.forEach((wallet) => { %><div class="settings-list-row"><strong><%= wallet.name %></strong><span><%= wallet.wallet_type === 'bank' ? 'Rekening bank' : wallet.wallet_type === 'ewallet' ? 'E-Wallet' : 'Tunai' %><%= wallet.institution ? ` · ${wallet.institution}` : '' %></span></div><% }) %></div><% } else { %><p class="empty-inline">Belum ada wallet.</p><% } %></section>
</div>
<%- include('../partials/app-foot') %>