<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>PILIH SESUAI KEBUTUHAN</div><h1>Paket <em>TataDana.</em></h1><p class="heading-copy">Permintaan paket akan menunggu persetujuan admin.</p></div></section>
<% if (subscription) { %><div class="subscription-banner">Paket terakhir: <strong><%= subscription.plan === 'starter' ? 'Starter' : 'Pro' %></strong> · Status <strong><%= subscription.status === 'active' ? 'Aktif' : subscription.status === 'pending' ? 'Menunggu persetujuan' : 'Berakhir' %></strong></div><% } %>
<section class="plan-grid">
  <article class="plan-card"><span class="section-kicker">UNTUK MEMULAI</span><h2>Starter</h2><div class="plan-price">Rp49.000 <small>/ bulan</small></div><p>Catat dan pahami arus uang harianmu.</p><ul><li>Wallet, transaksi, kategori, budget</li><li>Dashboard dan laporan CSV</li><li>Input teks lewat Telegram</li></ul><form method="post" action="/plans/starter/subscribe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-outline" type="submit">Ajukan Starter <span>↗</span></button></form></article>
  <article class="plan-card plan-featured"><span class="plan-badge">AKSES LENGKAP</span><span class="section-kicker">UNTUK YANG SIAP TUMBUH</span><h2>Pro</h2><div class="plan-price">Rp99.000 <small>sekali bayar</small></div><p>Semua fitur TataDana, tanpa masa bulanan.</p><ul><li>Semua fitur Starter</li><li>Parsing foto struk dan voice note</li><li>Advisor AI saat provider dikonfigurasi</li></ul><form method="post" action="/plans/pro/subscribe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button button-dark" type="submit">Ajukan Pro <span>↗</span></button></form></article>
</section>
<%- include('../partials/app-foot') %>