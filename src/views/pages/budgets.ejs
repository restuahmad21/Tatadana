<%- include('../partials/app-head', { title, active }) %>
<section class="page-heading compact-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span>BATAS PENGELUARAN</div><h1>Budget <em>keuangan.</em></h1><p class="heading-copy">Atur batas dan pantau pengeluaran per kategori.</p></div></section>
<nav class="period-segments budget-periods" aria-label="Filter periode budget"><a class="<%= period === 'daily' ? 'is-selected' : '' %>" href="/budgets?period=daily">Harian</a><a class="<%= period === 'weekly' ? 'is-selected' : '' %>" href="/budgets?period=weekly">Mingguan</a><a class="<%= period === 'monthly' ? 'is-selected' : '' %>" href="/budgets?period=monthly">Bulanan</a></nav>
<div class="budget-page-grid">
  <section class="surface-section budget-records"><div class="section-heading"><div><span class="section-kicker">PERIODE <%= period === 'daily' ? 'HARIAN' : period === 'weekly' ? 'MINGGUAN' : 'BULANAN' %></span><h2>Budget berjalan</h2></div><span class="table-total"><%= budgets.length %> kategori</span></div>
    <% if (budgets.length) { %><div class="budget-list"><% budgets.forEach((budget) => { %><article class="budget-row"><div class="budget-meta"><span><%= budget.emoji %> <%= budget.name %></span><strong><%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(budget.spent) %> <small>/ <%= new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(budget.limit_amount) %></small></strong></div><div class="progress-track"><span class="progress-fill <%= budget.percent >= budget.alert_threshold ? 'progress-alert' : '' %>" style="width:<%= budget.percent %>%"></span></div><small class="budget-percent"><%= budget.percent %>% terpakai<% if (budget.percent >= budget.alert_threshold) { %> · mendekati batas<% } %> · alert <%= budget.alert_threshold %>%</small></article><% }) %></div><% } else { %><div class="report-empty"><span>◷</span><h2>Belum ada budget <%= period === 'daily' ? 'harian' : period === 'weekly' ? 'mingguan' : 'bulanan' %></h2><p>Budget akan terhitung dari pengeluaran asli yang dicatat pada periode ini.</p></div><% } %>
  </section>
  <section class="surface-section"><div class="section-heading"><div><span class="section-kicker">TAMBAH ATAU PERBARUI</span><h2>Atur limit</h2></div></div><form class="stack-form" action="/budgets" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="period_type" value="<%= period %>"><label for="budget-category">Kategori pengeluaran</label><select id="budget-category" name="categoryId" required><% categories.forEach((category) => { %><option value="<%= category.id %>"><%= category.emoji %> <%= category.name %></option><% }) %></select><label for="budget-period-date"><%= period === 'daily' ? 'Tanggal' : period === 'weekly' ? 'Pilih tanggal dalam minggu' : 'Bulan' %></label><input id="budget-period-date" name="period_date" type="date" value="<%= currentDate %>" required><label for="budget-limit">Batas nominal (Rp)</label><input id="budget-limit" name="limitAmount" type="number" min="1" step="1" inputmode="numeric" required><label for="budget-threshold">Peringatan pada (%)</label><input id="budget-threshold" name="alertThreshold" type="number" min="1" max="100" value="80" required><button class="button button-dark form-submit" type="submit">Simpan budget <span>↗</span></button></form></section>
</div>
<%- include('../partials/app-foot') %>
