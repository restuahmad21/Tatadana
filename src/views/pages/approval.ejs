<%- include('../partials/public-head', { title }) %>
<main class="approval-main" data-approval-page data-status-url="/approval/status">
  <div class="approval-mark"><span class="brand-mark">t</span></div>
  <div class="eyebrow"><span class="eyebrow-line"></span>STATUS PENDAFTARAN</div>
  <h1 id="approval-heading"><%= user.approval_status === 'rejected' ? 'Pendaftaran belum disetujui.' : 'Satu langkah lagi.' %></h1>
  <p class="approval-copy" data-approval-message>
    <% if (user.approval_status === 'rejected') { %>
      Pendaftaran untuk <strong><%= user.email %></strong> tidak disetujui.<% if (user.rejection_reason) { %> Alasan: <%= user.rejection_reason %><% } %>
    <% } else { %>
      Halo <strong><%= user.name %></strong>, akunmu sudah tercatat dan sedang menunggu persetujuan admin. Status akan diperbarui otomatis.
    <% } %>
  </p>
  <div class="approval-status" role="status" aria-live="polite"><span class="approval-indicator <%= user.approval_status === 'rejected' ? 'is-rejected' : '' %>" data-approval-indicator></span><span data-approval-label><%= user.approval_status === 'rejected' ? 'Tidak disetujui' : 'Menunggu persetujuan' %></span></div>
  <p class="approval-error" data-approval-error hidden>Koneksi status terputus. Kamu dapat mencoba lagi secara manual.</p>
  <button class="button button-outline" type="button" data-approval-retry hidden>Cek status lagi</button>
  <a class="approval-back" href="/">Kembali ke beranda</a>
</main>
<script src="/approval.js" defer></script>
<%- include('../partials/public-foot') %>