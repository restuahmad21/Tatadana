<%- include('../partials/public-head', { title }) %>
<main class="login-main register-main">
  <a class="back-link" href="/">← <span>Kembali ke beranda</span></a>
  <div class="login-panel">
    <div class="eyebrow"><span class="eyebrow-line"></span>MULAI TATA KEUANGANMU</div>
    <h1>Buat ruang<br><em>pertamamu.</em></h1>
    <p class="login-description">Semua dimulai kosong. Dompet pertama dan kategorimu disiapkan otomatis.</p>
    <% if (error) { %><div class="form-error" role="alert"><span>!</span><%= error %></div><% } %>
    <form class="login-form" method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="name">Nama lengkap</label><input id="name" name="name" type="text" autocomplete="name" value="<%= name %>" required maxlength="80">
      <label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" value="<%= email %>" required>
      <label for="password">Password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
      <button class="button button-dark login-submit" type="submit">Buat akun <span>↗</span></button>
    </form>
    <p class="login-footnote">Sudah punya akun? <a href="/login">Masuk di sini</a></p>
  </div>
</main>
<%- include('../partials/public-foot') %>